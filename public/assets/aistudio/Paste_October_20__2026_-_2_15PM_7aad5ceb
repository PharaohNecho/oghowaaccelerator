<script>
    function scrollToSection(id) {
      const el = document.getElementById(id);
      if (el) {
        const yOffset = -90;
        const y = el.getBoundingClientRect().top + window.pageYOffset + yOffset;
        window.scrollTo({ top: y, behavior: 'smooth' });
      }
    }

    function handlePrimaryEmailChange(val) {
      const confEmail = document.getElementById('confirmation_email');
      if (confEmail && !confEmail.value) {
        // Subtle hint helper
        confEmail.placeholder = val ? 'Confirm: ' + val : 'Confirm or repeat email address';
      }
    }

    function updatePersonaCards() {
      const cards = document.querySelectorAll('.persona-card');
      cards.forEach(card => {
        const radio = card.querySelector('input[type="radio"]');
        if (radio && radio.checked) {
          card.classList.add('bg-primary', 'text-on-primary', 'shadow-md');
          card.classList.remove('bg-surface-ivory');
          const title = card.querySelector('span.font-label-lg');
          if (title) title.classList.add('text-on-primary');
          const sub = card.querySelector('span.font-body-sm');
          if (sub) sub.classList.add('text-surface-container-high');
          const icon = card.querySelector('.material-symbols-outlined');
          if (icon) icon.classList.add('text-accent-amber-soft');
        } else {
          card.classList.remove('bg-primary', 'text-on-primary', 'shadow-md');
          card.classList.add('bg-surface-ivory');
          const title = card.querySelector('span.font-label-lg');
          if (title) title.classList.remove('text-on-primary');
          const sub = card.querySelector('span.font-body-sm');
          if (sub) sub.classList.remove('text-surface-container-high');
          const icon = card.querySelector('.material-symbols-outlined');
          if (icon) icon.classList.remove('text-accent-amber-soft');
        }
      });
      syncSummary();
    }

    function toggleSummaryReview() {
      syncSummary();
      const content = document.getElementById('summaryReviewContent');
      const chevron = document.getElementById('summaryChevron');
      if (content.classList.contains('hidden')) {
        content.classList.remove('hidden');
        chevron.classList.add('rotate-180');
      } else {
        content.classList.add('hidden');
        chevron.classList.remove('rotate-180');
      }
    }

    function syncSummary() {
      const name = document.getElementById('full_name')?.value || '— Not filled —';
      const email = document.getElementById('primary_email')?.value || '—';
      const org = document.getElementById('organisation')?.value || '— Not filled —';
      const role = document.getElementById('job_role')?.value || '—';
      const loc = document.getElementById('location')?.value || '—';
      const attendance = document.querySelector('input[name="attendance_mode"]:checked')?.value;

      document.getElementById('sumName').textContent = name;
      document.getElementById('sumEmail').textContent = email;
      document.getElementById('sumOrg').textContent = org;
      document.getElementById('sumRole').textContent = role;
      document.getElementById('sumLocation').textContent = loc;
      document.getElementById('sumFormat').textContent = attendance === 'virtual' ? 'Virtual Stream Pass' : 'In-Person Delegate (Benin City)';
    }

    function saveDraftNotification() {
      syncSummary();
      const btn = event.currentTarget;
      const originalHtml = btn.innerHTML;
      btn.innerHTML = '<span class="material-symbols-outlined text-[18px]">check</span> Draft Saved Locally';
      btn.classList.add('bg-surface-ivory-alt');
      setTimeout(() => {
        btn.innerHTML = originalHtml;
        btn.classList.remove('bg-surface-ivory-alt');
      }, 2500);
    }

    function handleSubmit() {
      syncSummary();
      const nameVal = document.getElementById('full_name')?.value || 'Esteemed Delegate';
      const modeVal = document.querySelector('input[name="attendance_mode"]:checked')?.value;
      const randomRef = 'OGH-2025-' + Math.floor(1000 + Math.random() * 9000);

      document.getElementById('modalAttendeeName').textContent = nameVal;
      document.getElementById('refBadgeCode').textContent = randomRef;
      document.getElementById('modalAttendeeMode').textContent = modeVal === 'virtual' ? 'Virtual Global Stream' : 'Physical Access Pass (Benin City)';

      const modal = document.getElementById('successModal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeModal() {
      const modal = document.getElementById('successModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Scroll listener for top step tracker
    window.addEventListener('scroll', () => {
      const secB = document.getElementById('section-participation');
      const secC = document.getElementById('section-logistics');
      if (!secB || !secC) return;

      const topOffset = window.scrollY + 200;
      const bTop = secB.offsetTop;
      const cTop = secC.offsetTop;

      const dot1 = document.getElementById('dot-1');
      const dot2 = document.getElementById('dot-2');
      const dot3 = document.getElementById('dot-3');
      const stepInd = document.getElementById('stepNumberIndicator');

      if (topOffset >= cTop) {
        stepInd.textContent = '3';
        dot3.className = 'w-6 h-6 rounded-full bg-primary text-on-primary flex items-center justify-center font-label-caps text-label-caps transition-all';
        dot2.className = 'w-6 h-6 rounded-full bg-secondary-fixed text-primary flex items-center justify-center font-label-caps text-label-caps transition-all';
        dot1.className = 'w-6 h-6 rounded-full bg-secondary-fixed text-primary flex items-center justify-center font-label-caps text-label-caps transition-all';
      } else if (topOffset >= bTop) {
        stepInd.textContent = '2';
        dot2.className = 'w-6 h-6 rounded-full bg-primary text-on-primary flex items-center justify-center font-label-caps text-label-caps transition-all';
        dot1.className = 'w-6 h-6 rounded-full bg-secondary-fixed text-primary flex items-center justify-center font-label-caps text-label-caps transition-all';
        dot3.className = 'w-6 h-6 rounded-full bg-surface-ivory-alt text-text-muted flex items-center justify-center font-label-caps text-label-caps transition-all';
      } else {
        stepInd.textContent = '1';
        dot1.className = 'w-6 h-6 rounded-full bg-primary text-on-primary flex items-center justify-center font-label-caps text-label-caps transition-all';
        dot2.className = 'w-6 h-6 rounded-full bg-surface-ivory-alt text-text-muted flex items-center justify-center font-label-caps text-label-caps transition-all';
        dot3.className = 'w-6 h-6 rounded-full bg-surface-ivory-alt text-text-muted flex items-center justify-center font-label-caps text-label-caps transition-all';
      }
    });
  </script>
